---
import logo from '../assets/img/logo.svg';
import { LINKS, NAV } from '../data/site';
---

<header class="header">
  <div class="bar">
  <a class="logo" href="#inicio" aria-label="Playzone, el parque para todos. Ir al inicio">
    <img src={logo.src} width={logo.width} height={logo.height} alt="" />
    <span>El parque para todos</span>
  </a>

  <button class="menu-button" type="button" popovertarget="menu" aria-label="Abrir menú">
    <span></span>
  </button>

  <nav class="nav" id="menu" popover aria-label="Principal">
    <ul>
      {NAV.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </nav>

  <a class="btn btn--yellow cta" href={LINKS.book}>Aparta tu fecha</a>
  </div>
</header>

<script>
  const menu = document.getElementById('menu')!;
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgb(251 248 245 / 0.94);
  }

  .bar {
    display: flex;
    align-items: center;
    max-width: 72.4rem;
    min-height: var(--header-h);
    margin-inline: auto;
    padding: 0.2rem 3rem;
  }

  .logo { position: relative; width: 10.6rem; flex: none; }
  .logo img { width: 100%; height: auto; }

  .logo span {
    position: absolute;
    left: 31%;
    bottom: 6%;
    font-size: max(0.76rem, 11px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    color: #17171c;
  }

  .nav {
    position: static;
    display: block;
    margin: 0 2rem 0 auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
  }

  .nav ul { display: flex; gap: 0.5rem; }

  .nav a {
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: 99rem;
    font-size: max(1rem, 14px);
    font-weight: 800;
    letter-spacing: -0.01em;
    transition: background 0.16s, color 0.16s;
  }

  @media (hover: hover) {
    .nav a:hover { background: var(--panel); color: var(--royal); }
  }

  .cta { font-size: max(1rem, 14px); padding-block: 0.56em; }

  .menu-button { display: none; }

  @media (width < 860px) {
    .bar { padding: 0.4rem 1.4rem; gap: 1rem; }
    .logo { width: 13.6rem; margin-right: auto; }
    .logo span { font-size: 1.04rem; }

    .menu-button {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #fff;
      box-shadow: inset 0 0 0 2px var(--navy);
      color: var(--ink);
      cursor: pointer;
    }

    .menu-button span,
    .menu-button span::before,
    .menu-button span::after {
      display: block;
      width: 18px;
      height: 2.5px;
      border-radius: 2px;
      background: currentColor;
    }

    .menu-button span { position: relative; }
    .menu-button span::before,
    .menu-button span::after { content: ''; position: absolute; }
    .menu-button span::before { top: -6px; }
    .menu-button span::after { top: 6px; }

    .nav { display: none; }

    .nav:popover-open {
      position: fixed;
      inset: 7rem 1.4rem auto auto;
      display: block;
      margin: 0;
      padding: 0.8rem;
      border-radius: 1.8rem;
      background: #fff;
      box-shadow: 0 1rem 3rem rgb(0 30 90 / 0.22);
    }

    .nav ul { flex-direction: column; gap: 0; }
    .nav a { padding: 12px 18px; font-size: 16px; }
    .cta { font-size: 13.5px; padding-inline: 1.1em; }
    .cta::after { display: none; }
  }
</style>
