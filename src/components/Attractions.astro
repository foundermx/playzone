---
import { Picture } from 'astro:assets';
import muro from '../assets/img/muro.jpg';
import tirolesa from '../assets/img/tirolesa.jpg';
import trampolines from '../assets/img/trampolines.jpg';
import { roundedPath, type Vertex } from '../lib/rounded-path';

/**
 * Four interlocking pieces drawn on one 652 x 305 sheet (mockup px). Each starts away
 * from its slot and locks in as the page scrolls: `from` is the offset in em and the
 * spin in degrees, `lock` the slice of the scroll in which it travels.
 */
interface Piece {
  tone: 'red' | 'green' | 'blue';
  outline: Vertex[];
  studs: [number, number][];
  from: { x: number; y: number; spin: number };
  lock: [number, number];
  photo?: {
    src: ImageMetadata;
    alt: string;
    box: [number, number, number, number];
    clip?: string;
  };
  label?: { lines: string[]; x: number; y: number; size: number };
}

const pieces: Piece[] = [
  {
    tone: 'green',
    outline: [[196, 5], [454.5, 5], [454.5, 106.5], [362.5, 106.5], [362.5, 175], [254, 175], [254, 237], [196, 237]],
    studs: [[418.5, 31], [224, 207]],
    from: { x: -5, y: -27, spin: 9 },
    lock: [0, 0.62],
    photo: {
      src: trampolines,
      alt: 'Niño saltando feliz en un trampolín',
      box: [203, 11.5, 177.5, 185.5],
      clip: 'polygon(0 0, 100% 0, 100% 51%, 86% 51%, 86% 85%, 25% 85%, 25% 100%, 0 100%)',
    },
  },
  {
    tone: 'red',
    outline: [[0, 0], [86.5, 0], [86.5, 48], [189, 48], [189, 244], [254, 244], [254, 304], [0, 304]],
    studs: [[25.5, 25.5], [59.5, 25.5], [164.5, 274.5], [217.5, 274.5]],
    from: { x: -32, y: 13, spin: -15 },
    lock: [0.14, 0.76],
    photo: { src: tirolesa, alt: 'Niña con casco deslizándose en la tirolesa', box: [8, 55.5, 174, 157.5] },
    label: { lines: ['Tirolesa'], x: 80, y: 246, size: 2.9 },
  },
  {
    tone: 'green',
    outline: [[367, 114], [458, 114], [458, 240], [373, 240], [373, 304], [261.5, 304], [261.5, 179], [367, 179]],
    studs: [[396.5, 145], [431.5, 145], [293.5, 274.5], [339.5, 274.5]],
    from: { x: 7, y: 27, spin: -11 },
    lock: [0.26, 0.88],
    label: { lines: ['Trampolines'], x: 360, y: 211, size: 2.95 },
  },
  {
    tone: 'blue',
    outline: [[548, 0], [651.5, 0], [651.5, 304], [380, 304], [380, 247], [462, 247], [462, 48], [548, 48]],
    studs: [[577.5, 25.5], [620, 25.5], [406.5, 274.5], [442.5, 274.5], [620, 274.5]],
    from: { x: 32, y: 13, spin: 15 },
    lock: [0.38, 1],
    photo: { src: muro, alt: 'Niña subiendo por un muro de escalar', box: [470, 55.5, 173, 157.5] },
    label: { lines: ['Muro de', 'escalar'], x: 541, y: 258, size: 2.65 },
  },
];
---

<div class="tiles" data-scroll-progress data-start="0.96" data-end="0.34">
  {
    pieces.map(({ tone, outline, studs, from, lock, photo, label }) => (
      <article
        class="piece"
        style={`--dx: ${from.x}em; --dy: ${from.y}em; --spin: ${from.spin}deg; --from: ${lock[0]}; --to: ${lock[1]}`}
      >
        <svg viewBox="0 0 652 305" aria-hidden="true">
          <path d={roundedPath(outline, 9)} fill="#0a3a8c" opacity="0.2" transform="translate(0 7)" filter="url(#soft-shadow)" />
          <path d={roundedPath(outline, 9)} fill={`url(#paint-${tone})`} filter="url(#plastic)" />
          {studs.map(([cx, cy]) => <circle cx={cx} cy={cy} r="13" fill={`url(#stud-${tone})`} filter="url(#plastic-stud)" />)}
        </svg>
        {photo && (
          <Picture
            class="photo"
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={[360, 692]}
            sizes="(max-width: 859px) 44vw, 290px"
            style={`left: ${photo.box[0] / 10}em; top: ${photo.box[1] / 10}em; width: ${photo.box[2] / 10}em; height: ${photo.box[3] / 10}em; ${photo.clip ? `clip-path: ${photo.clip}` : ''}`}
          />
        )}
        {label && <h3 style={`left: ${label.x / 10 / label.size}em; top: ${label.y / 10 / label.size}em; font-size: ${label.size}em`}>{label.lines.map((line) => <span>{line}</span>)}</h3>}
      </article>
    ))
  }
</div>

<style>
  .tiles {
    --p: 1;
    position: relative;
    width: 65.2em;
    height: 30.5em;
    margin-inline: auto;
    font-size: 1rem;
  }

  .piece {
    --q: clamp(0, (var(--p) - var(--from)) / (var(--to) - var(--from)), 1);
    --left: calc((1 - var(--q)) * (1 - var(--q)));
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--dx) * var(--left)), calc(var(--dy) * var(--left)), 0) rotate(calc(var(--spin) * var(--left)));
    opacity: clamp(0, var(--q) * 3, 1);
    pointer-events: none;
    will-change: transform;
  }

  .piece svg { width: 100%; height: 100%; overflow: visible; }

  :global(.photo) {
    position: absolute;
    object-fit: cover;
    border-radius: 0.2em;
  }

  h3 {
    position: absolute;
    translate: -50% -50%;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    color: #fff;
    text-shadow: 0 0.05em 0.1em rgb(0 0 0 / 0.25);
  }

  h3 span { display: block; }

  /* The moment the last piece seats: a short press, like bricks clicking together. */
  :global(.tiles.is-done) .piece { animation: click 0.32s ease-out; }

  @keyframes click {
    40% { scale: 0.985; }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece { transform: none; opacity: 1; animation: none; }
  }

  @media (width < 860px) {
    .tiles { font-size: 0.56rem; }
  }
</style>
