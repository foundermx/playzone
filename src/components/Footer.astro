---
import logo from '../assets/img/logo.svg';
import { ADDRESS, CITY, LINKS, NAV, PHONE_LABEL } from '../data/site';
import { WHATSAPP_GLYPH } from '../lib/icons';

const year = new Date().getFullYear();

/*
 * The footer is a baseplate seen from the front and a little above, and everything on it is a
 * piece: links are bricks standing on the studs, text is printed on smooth tiles. The view is
 * the same throughout, looking down at 40 degrees: a stud is 2.4rem across and a row of studs
 * 1.5rem deep, so the studs on the bricks line up with the plate's.
 */

/** Lighter (amount > 0) or darker (amount < 0) version of a hex colour. */
const shade = (hex: string, amount: number) => {
  const n = parseInt(hex.slice(1), 16);
  const channels = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.round(amount < 0 ? v * (1 + amount) : v + (255 - v) * amount));
  return `#${channels.map((v) => v.toString(16).padStart(2, '0')).join('')}`;
};

const svg = (body: string) =>
  `url('data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 15">${body}</svg>`)}')`;

/**
 * One stud in a 2.4 x 1.5rem cell: lit top, round side darkening to the right. `soft` is for
 * the plate, whose studs stay quiet behind the pieces and cast a little shadow.
 */
const stud = (tone: string, soft = false) =>
  svg(
    `<defs><linearGradient id="s" x1="0" x2="1"><stop offset="0" stop-color="${shade(tone, soft ? 0.05 : 0.1)}"/><stop offset="1" stop-color="${shade(tone, soft ? -0.28 : -0.38)}"/></linearGradient></defs>` +
      (soft ? `<ellipse cx="13.8" cy="9.6" rx="7.6" ry="4" fill="#000814" fill-opacity=".26"/>` : '') +
      `<path d="M4.8 4.6v3.9a7.2 4.5 0 0 0 14.4 0V4.6z" fill="url(#s)"/>` +
      `<ellipse cx="12" cy="4.6" rx="7.2" ry="4.5" fill="${shade(tone, soft ? 0.09 : 0.16)}"/>` +
      `<ellipse cx="9.6" cy="3.4" rx="3.4" ry="1.6" fill="#fff" fill-opacity="${soft ? 0.12 : 0.32}"/>`,
  );

const PLATE = '#0d2a78';

const TONES = {
  red: ['#d8141a', '#fff'],
  yellow: ['#fdc904', '#00124d'],
  blue: ['#1270f0', '#fff'],
  green: ['#14a828', '#fff'],
  orange: ['#f58a1f', '#fff'],
  white: ['#f4f4f0', '#0c2a6e'],
  whatsapp: ['#25b84a', '#fff'],
} as const;

type Tone = keyof typeof TONES;

const brick = (tone: Tone, extra = '') => {
  const [base, ink] = TONES[tone];
  return `--tone: ${base}; --hi: ${shade(base, 0.2)}; --lo: ${shade(base, -0.24)}; --ink: ${ink}; --studs: ${stud(base)}; ${extra}`;
};

const explore = [{ label: 'Galería', href: '#galeria' }, ...NAV];
const towerTones: Tone[] = ['red', 'yellow', 'blue', 'green', 'orange'];

/** Colours for the bricks a visitor drops on the plate; read by the script below. */
const looseBricks = (['red', 'yellow', 'blue', 'green', 'orange', 'white'] as Tone[]).map((tone) => brick(tone));
---

<footer class="footer" style={`--plate: ${PLATE}; --plate-studs: ${stud(shade(PLATE, 0.12), true)}`} data-bricks={JSON.stringify(looseBricks)}>
  <!-- Bricks dropped by tapping the plate land here, under the footer's own pieces. -->
  <div class="yard" aria-hidden="true"></div>

  <div class="inner">
    <div class="brand">
      <a class="brick brick--logo drop" data-drop href="#inicio" style={brick('white', '--tumble: -8deg')} aria-label="Playzone, el parque para todos. Volver al inicio">
        <img src={logo.src} width={logo.width} height={logo.height} alt="" loading="lazy" />
      </a>
      <p class="tile">
        El parque para todos en {CITY}: tirolesa, circuito de cuerdas, muro de escalar, pelotas acuáticas,
        lanchitas y área privada para fiestas.
      </p>
      <a class="brick brick--big drop" data-drop href={LINKS.book} style={brick('yellow', '--tumble: 10deg; --drop-delay: 0.15s')}>
        Aparta tu fecha
        <svg class="arrow" viewBox="0 0 21 15" aria-hidden="true"><path d="M1 7.5h18M13 1.5l6 6-6 6" /></svg>
      </a>
    </div>

    <nav class="column" aria-label="Secciones">
      <h2 class="label">Explora</h2>
      <!-- A stack of bricks, one per section: the top one shows its studs, hovering pulls one out. -->
      <ul class="tower">
        {
          explore.map(({ label, href }, i) => (
            <li style={`z-index: ${explore.length - i}`}>
              <a
                class="brick drop"
                data-drop
                href={href}
                style={brick(towerTones[i % towerTones.length], `--tumble: ${i % 2 ? 6 : -6}deg; --drop-delay: ${(explore.length - 1 - i) * 0.11}s`)}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="column">
      <h2 class="label">Visítanos</h2>
      <address class="tile">
        <svg viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M8 0a7.5 7.5 0 0 0-7.5 7.5C.5 13 8 20 8 20s7.5-7 7.5-12.5A7.5 7.5 0 0 0 8 0Zm0 10.4a2.9 2.9 0 1 1 0-5.8 2.9 2.9 0 0 1 0 5.8Z" /></svg>
        <span>{ADDRESS}<br />{CITY}</span>
      </address>
      <div class="pair">
        <a class="brick drop" data-drop href={LINKS.map} style={brick('blue', '--tumble: -10deg; --drop-delay: 0.1s')}>Cómo llegar</a>
        <a class="brick drop" data-drop href={LINKS.hours} style={brick('whatsapp', '--tumble: 8deg; --drop-delay: 0.22s')}>
          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WHATSAPP_GLYPH} /></svg>
          <span><span class="sr-only">WhatsApp </span>{PHONE_LABEL}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="legal">
    <p class="tile tile--dark">© {year} Playzone Córdoba</p>
    <p class="tile tile--dark hint" data-hint>Toca la plancha y construye</p>
    <a class="brick brick--small drop" data-drop href="#inicio" style={brick('red', '--tumble: 12deg')}>Volver arriba ↑</a>
  </div>
</footer>

<script>
  /*
   * Tap any bare spot of the plate and a brick drops there, snapped to the studs. Tap the same
   * spot again and the next one lands on top of it.
   */
  const footer = document.querySelector<HTMLElement>('.footer')!;
  const yard = footer.querySelector<HTMLElement>('.yard')!;
  const hint = footer.querySelector<HTMLElement>('[data-hint]')!;
  const looks: string[] = JSON.parse(footer.dataset.bricks!);

  /** Plate geometry in rem, as in the stylesheet. */
  const PITCH = 2.4;
  const ROW = 1.5;
  const HEIGHT = 2.2;
  /** From the top of a stud row to where a brick standing on it meets the plate in front. */
  const FOOT = 1.6;
  const MAX_PIECES = 40;
  const MAX_LEVEL = 5;

  const placed: { element: HTMLElement; row: number; col: number; width: number; level: number }[] = [];

  footer.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a, button, .tile:not(.hint), .label')) return;
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    const box = footer.getBoundingClientRect();
    const columns = Math.floor(box.width / (PITCH * rem));
    const width = [1, 2, 2, 2, 3, 4][Math.floor(Math.random() * 6)];
    const col = Math.max(0, Math.min(Math.round((event.clientX - box.left) / (PITCH * rem) - width / 2), columns - width));
    const row = Math.floor((event.clientY - box.top) / (ROW * rem));
    const under = placed.filter((piece) => piece.row === row && piece.col < col + width && col < piece.col + piece.width);
    const level = under.length ? Math.max(...under.map((piece) => piece.level)) + 1 : 0;
    if (level > MAX_LEVEL) return;

    const element = document.createElement('span');
    element.className = 'loose drop is-dropped';
    element.style.cssText = `${looks[Math.floor(Math.random() * looks.length)]}
      left: ${col * PITCH}rem; top: ${row * ROW + FOOT - HEIGHT * (level + 1)}rem; width: ${width * PITCH}rem;
      z-index: ${row * 10 + level}; --fall: -16rem; --tumble: ${(Math.random() - 0.5) * 50}deg; --drop-time: 0.9s;`;
    yard.append(element);
    placed.push({ element, row, col, width, level });

    if (placed.length > MAX_PIECES) placed.shift()!.element.remove();
    if (placed.length === 1) hint.textContent = '¡Eso! Sigue construyendo';
  });
</script>

<style>
  /* The baseplate: navy, studs in rows, its thickness showing at the very bottom of the page. */
  .footer {
    position: relative;
    margin-top: 2rem;
    padding-top: 1.5rem;
    background: var(--plate-studs) 0 0 / 2.4rem 1.5rem, var(--plate);
    box-shadow: inset 0 0.16rem 0 rgb(255 255 255 / 0.12);
    color: var(--ink);
    cursor: pointer;
  }

  .footer::after {
    content: '';
    display: block;
    height: 1.1rem;
    background: linear-gradient(#0a2160, #051538);
    box-shadow: inset 0 0.14rem 0 rgb(255 255 255 / 0.1);
  }

  .yard {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .inner, .legal { position: relative; z-index: 1; }

  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 4rem;
    width: 66rem;
    margin-inline: auto;
    padding: 3.6rem 0 3rem;
  }

  /*
   * A brick: the element is its front face; ::before is its top face and ::after the studs on
   * it, in the brick's own colours (inline --tone, --hi, --lo, --ink, --studs).
   */
  .brick, :global(.loose) {
    position: relative;
    border-radius: 0 0 0.4rem 0.4rem;
    background: linear-gradient(var(--tone), var(--lo));
    box-shadow:
      inset 0 0.1rem 0 rgb(255 255 255 / 0.28),
      inset 0 -0.22rem 0 rgb(0 0 0 / 0.12),
      0.35rem 0.9rem 1rem rgb(0 6 30 / 0.5);
  }

  .brick::before, :global(.loose)::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 1.5rem;
    border-radius: 0.4rem 0.4rem 0 0;
    background: linear-gradient(var(--hi), var(--tone));
    box-shadow: inset 0 0.08rem 0 rgb(255 255 255 / 0.35);
  }

  .brick::after, :global(.loose)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 0.1rem);
    height: 1.5rem;
    background: var(--studs) 0 0 / 2.4rem 1.5rem space no-repeat;
  }

  .brick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 2.8rem;
    margin-top: 1.8rem;
    padding: 0.3rem 1.4rem 0.45rem;
    font-size: max(1.15rem, 15px);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink);
    cursor: pointer;
    transition: translate 0.18s var(--press), box-shadow 0.18s var(--press);
  }

  /* Picked up off the plate on hover; pressed back onto its studs on click. */
  @media (hover: hover) {
    .brick:hover {
      translate: 0 -0.45rem;
      box-shadow:
        inset 0 0.1rem 0 rgb(255 255 255 / 0.28),
        inset 0 -0.22rem 0 rgb(0 0 0 / 0.12),
        0.6rem 1.5rem 1.4rem rgb(0 6 30 / 0.42);
    }
  }

  .brick:active { translate: 0 0.12rem; transition-duration: 0.06s; }

  /* Bricks dropped by visitors: no text, just the piece. */
  :global(.loose) {
    position: absolute;
    height: 2.2rem;
  }

  .brick--logo { padding: 0.8rem 1.6rem 0.7rem; }
  .brick--logo img { width: 12rem; height: auto; }
  .brick--big { min-height: 3.4rem; padding-inline: 1.8rem; font-size: max(1.3rem, 16px); }
  .brick--small { min-height: 2.4rem; margin: 0; font-size: max(0.95rem, 13px); }

  .arrow { width: 1.1em; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .glyph { width: 1.4em; }

  /* Smooth printed tiles: thin, so only a sliver of edge shows below the face. */
  .tile {
    position: relative;
    border-radius: 0.5rem;
    background: linear-gradient(#ffffff, #eceff6);
    box-shadow: 0 0.3rem 0 #b4bdd2, 0.3rem 0.8rem 1rem rgb(0 6 30 / 0.45);
    color: var(--ink);
    cursor: default;
  }

  .tile--dark {
    background: linear-gradient(#1b3a8f, #142f7a);
    box-shadow: 0 0.3rem 0 #091d55, 0.3rem 0.8rem 1rem rgb(0 6 30 / 0.4);
    color: #dbeafc;
  }

  .brand p {
    max-width: 30rem;
    margin-top: 1.8rem;
    padding: 1.2rem 1.4rem;
    font-size: var(--text);
    font-weight: 700;
    line-height: 1.45;
  }

  .brand .brick--big { margin-top: 2.4rem; }

  /* Section names printed on small yellow tiles. */
  .label {
    display: inline-block;
    margin-bottom: 1.6rem;
    padding: 0.5rem 0.9rem 0.45rem;
    border-radius: 0.4rem;
    background: linear-gradient(#ffd528, #f9c000);
    box-shadow: 0 0.26rem 0 #c48a00, 0.25rem 0.6rem 0.8rem rgb(0 6 30 / 0.4);
    font-family: var(--font-ui);
    font-size: max(1rem, 13px);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    cursor: default;
  }

  /* One shadow for the whole stack, so no brick darkens the one under it. */
  .tower {
    display: grid;
    padding-top: 1.6rem;
    filter: drop-shadow(0.35rem 0.9rem 0.8rem rgb(0 6 30 / 0.5));
  }

  .tower li { position: relative; }

  .tower .brick {
    display: flex;
    justify-content: flex-start;
    width: 100%;
    margin: 0;
    border-radius: 0.15rem;
    box-shadow: inset 0 0.1rem 0 rgb(255 255 255 / 0.28), inset 0 -0.22rem 0 rgb(0 0 0 / 0.14);
  }

  .tower li:first-child .brick { border-radius: 0 0 0.15rem 0.15rem; }
  .tower li:last-child .brick { border-radius: 0 0 0.4rem 0.4rem; }

  @media (hover: hover) {
    .tower .brick:hover {
      translate: 1rem 0;
      box-shadow: inset 0 0.1rem 0 rgb(255 255 255 / 0.28), inset 0 -0.22rem 0 rgb(0 0 0 / 0.14);
    }
  }

  .tower .brick:active { translate: 0.4rem 0; }

  address {
    display: flex;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    font-size: var(--text);
    font-style: normal;
    font-weight: 800;
    line-height: 1.35;
  }

  address svg { width: 1.1rem; flex: none; margin-top: 0.15rem; color: var(--red); }

  .pair { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; margin-top: 0.4rem; }

  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 66rem;
    margin-inline: auto;
    padding: 1rem 0 2.6rem;
  }

  .legal .tile { padding: 0.6rem 1rem; font-size: max(0.95rem, 13px); font-weight: 700; }

  /* Not a link: a tap on it goes through to the plate like anywhere else. */
  .legal .hint { color: var(--yellow); font-weight: 800; cursor: pointer; }

  @media (width < 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.6rem 2rem;
      width: auto;
      padding: 3rem 2.4rem 2.4rem;
    }

    .brand { grid-column: 1 / -1; }
    .brick--logo img { width: 15rem; }
    .brick { font-size: 1.5rem; }
    .brick--big { font-size: 1.7rem; }
    .brand p { font-size: 1.5rem; }
    .label { font-size: 1.3rem; }
    address { font-size: 1.4rem; padding: 1rem; }

    /* Bare plate left at the bottom on phones, where everything else fills the width: room to build. */
    .legal {
      flex-wrap: wrap;
      width: auto;
      margin-inline: 2.4rem;
      padding-bottom: calc(9rem + env(safe-area-inset-bottom));
    }

    .legal .tile { font-size: 1.3rem; }
    .legal .hint { order: 3; }
  }
</style>
