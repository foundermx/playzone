---
import { Picture } from 'astro:assets';
import building from '../assets/img/ubicacion.jpg';
import { ADDRESS, LINKS, PHONE_LABEL } from '../data/site';

const whatsappGlyph =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';
---

<section class="locations" id="ubicacion">
  <h2><span class="burst burst--both">Ubicaciones</span></h2>

  <div class="cards">
    <article class="place">
      <h3><span class="burst">Playzone Córdoba</span></h3>
      <Picture
        class="building"
        src={building}
        alt="Fachada de Playzone Córdoba"
        formats={['avif', 'webp']}
        widths={[440, 880]}
        sizes="(max-width: 859px) 80vw, 360px"
      />
      <div class="where">
        <svg viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M8 0a7.5 7.5 0 0 0-7.5 7.5C.5 13 8 20 8 20s7.5-7 7.5-12.5A7.5 7.5 0 0 0 8 0Zm0 10.4a2.9 2.9 0 1 1 0-5.8 2.9 2.9 0 0 1 0 5.8Z" /></svg>
        <address>{ADDRESS}</address>
        <a class="btn btn--yellow" href={LINKS.map}>Cómo llegar</a>
      </div>
    </article>

    <article class="hours">
      <h3><span class="burst burst--both">Horarios</span></h3>
      <a class="ask" href={LINKS.hours}>
        <span class="glyph"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={whatsappGlyph} /></svg></span>
        <span>Consulta los horarios<br />por WhatsApp</span>
      </a>
      <a class="phone" href={LINKS.hours}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={whatsappGlyph} /></svg>
        {PHONE_LABEL}
      </a>
    </article>
  </div>
</section>

<style>
  .locations {
    width: 66rem;
    margin: 4.6rem auto 0;
    padding-bottom: 4rem;
    text-align: center;
  }

  h2 { font-size: 4.5rem; font-weight: 900; color: var(--navy); }

  .cards {
    display: grid;
    grid-template-columns: 32.8rem 29.4rem;
    justify-content: space-between;
    margin-top: 2rem;
  }

  article { border-radius: 1.6rem; }

  h3 {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--navy);
  }

  h3 .burst::before, h3 .burst::after { width: 0.6em; }

  .place {
    padding: 0.9rem 1rem 0.8rem;
    background: #fff;
    box-shadow: inset 0 0 0 0.12rem var(--navy);
  }

  :global(.building) {
    width: 21.7rem;
    height: 3.3rem;
    margin: 0.3rem auto 0;
    border-radius: 0.8rem;
    object-fit: cover;

  }

  .where {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    font-size: max(0.95rem, 13px);
    font-weight: 800;
    color: var(--ink);
  }

  .where svg { width: 0.95rem; flex: none; }
  address { font-style: normal; }

  .where .btn { margin-left: 0.8rem; min-height: 36px; padding: 0.3em 1em; font-size: max(0.92rem, 13px); gap: 0.6em; }

  .hours {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1rem 1rem;
    background: linear-gradient(#ffd21f, #fdc300);
  }

  .ask, .phone {
    display: flex;
    align-items: center;
    width: 20.4rem;
    border-radius: 99rem;
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .ask {
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.2rem 1rem 0.2rem 0.5rem;
    background: #fff;
    color: var(--ink);
    font-size: max(0.92rem, 13px);
    line-height: 1.08;
    text-align: left;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border-radius: 50%;
    background: #25b84a;
    color: #fff;
  }

  .glyph svg { width: 1.5rem; }

  .phone {
    justify-content: center;
    gap: 0.8rem;
    min-height: 44px;
    background: var(--navy);
    color: #fff;
    font-size: max(1.2rem, 16px);
    letter-spacing: 0.03em;
  }

  .phone svg { width: 1.7rem; }

  @media (width < 860px) {
    .locations { width: 36rem; margin-top: 3.6rem; padding-bottom: 3rem; }
    .cards { display: block; }
    .place, .hours { padding: 1.4rem; }
    .hours { margin-top: 1.2rem; gap: 0.8rem; }
    h3 { font-size: 2.2rem; }
    :global(.building) { width: 100%; height: auto; aspect-ratio: 6.2; margin-top: 1rem; }
    .where { flex-wrap: wrap; margin-top: 1rem; font-size: 1.4rem; }
    .where .btn { font-size: 1.4rem; margin: 0.4rem 0 0; }
    .ask, .phone { width: 100%; }
    .ask { font-size: 1.4rem; }
    .glyph { width: 3.2rem; height: 3.2rem; }
    .glyph svg { width: 2rem; }
    .phone { font-size: 1.8rem; }
    .phone svg { width: 2.2rem; }
  }
</style>
