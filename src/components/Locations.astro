---
import { Picture } from 'astro:assets';
import facade from '../assets/img/fachada.webp';
import { ADDRESS, CITY, LINKS, PHONE_LABEL } from '../data/site';
import { WHATSAPP_GLYPH } from '../lib/icons';
import FlyingBricks, { type Piece } from './FlyingBricks.astro';

const pieces: Piece[] = [
  { brick: 'red-left', at: ['-11rem', '0rem', 7], phone: ['-1.8rem', '-5.4rem', 5], tumble: -130 },
  { brick: 'yellow', at: ['calc(100% + 3rem)', '17rem', 6.5], tumble: 150 },
];
---

<section class="locations" id="ubicacion">
  <FlyingBricks pieces={pieces} />
  <h2 class="reveal" data-scroll-progress data-start="0.95" data-end="0.7"><span class="burst burst--both">Ubicaciones</span></h2>

  <div class="cards" data-scroll-progress data-start="1" data-end="0.5">
    <article class="place snap">
      <Picture
        class="building"
        src={facade}
        alt="Fachada de Playzone Córdoba, un edificio azul decorado con bloques de colores"
        formats={['avif', 'webp']}
        widths={[560, 900, 1198]}
        sizes="(max-width: 859px) 90vw, 560px"
      />
      <div class="where">
        <h3>Playzone Córdoba</h3>
        <address>
          <svg viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M8 0a7.5 7.5 0 0 0-7.5 7.5C.5 13 8 20 8 20s7.5-7 7.5-12.5A7.5 7.5 0 0 0 8 0Zm0 10.4a2.9 2.9 0 1 1 0-5.8 2.9 2.9 0 0 1 0 5.8Z" /></svg>
          <span>{ADDRESS}<br />{CITY}</span>
        </address>
        <a class="btn btn--yellow" href={LINKS.map}>Cómo llegar</a>
      </div>
    </article>

    <article class="hours snap">
      <h3><span class="burst burst--both">Horarios</span></h3>
      <p>Escríbenos y te compartimos los horarios del día.</p>
      <a class="ask" href={LINKS.hours}>
        <span class="glyph"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WHATSAPP_GLYPH} /></svg></span>
        <span>Consulta los horarios<br />por WhatsApp</span>
      </a>
      <a class="phone" href={LINKS.hours} aria-label={`WhatsApp ${PHONE_LABEL}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={WHATSAPP_GLYPH} /></svg>
        {PHONE_LABEL}
      </a>
    </article>
  </div>
</section>

<style>
  .locations {
    position: relative;
    width: 66rem;
    margin: 5.5rem auto 0;
    padding-bottom: 7rem;
    text-align: center;
  }

  h2 { font-size: 4.5rem; font-weight: 900; color: var(--navy); }

  .cards {
    --p: 1;
    display: grid;
    grid-template-columns: 37rem 1fr;
    gap: 2.2rem;
    margin-top: 2.6rem;
    text-align: left;
  }

  /* The two cards slide in from either side and click together like two bricks. */
  article {
    position: relative;
    border-radius: 2rem;
    opacity: clamp(0, var(--q) * 2.5, 1);
  }

  .place {
    --q: clamp(0, var(--p) / 0.7, 1);
    transform: translateX(calc(var(--off) * -6rem)) rotate(calc(var(--off) * -4deg));
  }

  .hours {
    --q: clamp(0, (var(--p) - 0.15) / 0.7, 1);
    transform: translateX(calc(var(--off) * 6rem)) rotate(calc(var(--off) * 4deg));
  }

  h3 {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--navy);
  }

  .place {
    padding: 1.2rem;
    background: #fff;
    box-shadow: inset 0 0 0 0.12rem var(--navy), 0 0.3rem 0 var(--navy);
  }

  /* A cutout of the building: shown whole, rising onto its card as the card lands. */
  :global(.building) {
    width: 100%;
    height: auto;
    aspect-ratio: 2.56;
    object-fit: contain;
    transform: translateY(calc((1 - var(--q)) * 1.6rem));
  }

  .where {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.6rem 1.2rem;
    padding: 1.4rem 0.6rem 0.4rem;
  }

  .where h3 { grid-column: 1; }

  address {
    grid-column: 1;
    display: flex;
    gap: 0.6rem;
    font-size: var(--text);
    font-style: normal;
    font-weight: 800;
    line-height: 1.3;
    color: var(--ink);
  }

  address svg { width: 1.1rem; flex: none; margin-top: 0.2rem; color: var(--red); }

  .where .btn { grid-column: 2; grid-row: 1 / span 2; }

  .hours {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1rem;
    padding: 2.4rem 2.2rem;
    background: linear-gradient(#ffd21f, #fdc300);
    box-shadow: 0 0.3rem 0 #d99a00;
    text-align: center;
  }

  /* Yellow strokes vanish on yellow: navy here. */
  .hours .burst::before, .hours .burst::after { width: 0.6em; background-image: var(--burst-ink); }

  .hours p {
    max-width: 24rem;
    margin-bottom: 0.4rem;
    font-size: var(--text);
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
  }

  .ask, .phone {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 24rem;
    border-radius: 99rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    transition: translate 0.16s var(--press), box-shadow 0.16s var(--press);
  }

  .ask {
    gap: 0.9rem;
    min-height: 52px;
    padding: 0.3rem 1.2rem 0.3rem 0.4rem;
    background: #fff;
    box-shadow: 0 0.2rem 0 rgb(150 100 0 / 0.35);
    color: var(--ink);
    font-size: max(1rem, 14px);
    line-height: 1.1;
    text-align: left;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    flex: none;
    border-radius: 50%;
    background: #25b84a;
    color: #fff;
  }

  .glyph svg { width: 2rem; }

  .phone {
    justify-content: center;
    gap: 0.8rem;
    min-height: 52px;
    background: var(--navy);
    box-shadow: 0 0.2rem 0 var(--ink);
    color: #fff;
    font-size: max(1.4rem, 17px);
    letter-spacing: 0.03em;
  }

  .phone svg { width: 1.9rem; }

  @media (hover: hover) {
    .ask:hover, .phone:hover { translate: 0 -0.1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    article, :global(.building) { opacity: 1; transform: none; }
  }

  @media (width < 860px) {
    .locations { width: 36rem; margin-top: 4.4rem; padding-bottom: 5rem; }
    .cards { display: block; margin-top: 2rem; }
    .place { padding: 1rem; }
    :global(.building) { aspect-ratio: 2.56; }
    .where { grid-template-columns: 1fr; padding: 1.4rem 0.6rem 0.6rem; }
    .where .btn { grid-column: 1; grid-row: auto; justify-self: start; margin-top: 0.6rem; }
    h3 { font-size: 2.4rem; }
    address { font-size: 1.5rem; }
    address svg { width: 1.3rem; }
    .hours { margin-top: 1.6rem; padding: 2.4rem 1.6rem; }
    .hours p { font-size: 1.5rem; }
    .ask { font-size: 1.5rem; }
    .glyph { width: 3.8rem; height: 3.8rem; }
    .glyph svg { width: 2.2rem; }
    .phone { font-size: 1.9rem; }
    .phone svg { width: 2.2rem; }
  }
</style>
