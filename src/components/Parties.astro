---
import { Picture } from 'astro:assets';
import photo from '../assets/img/cafeteria.jpg';
import { LINKS } from '../data/site';
import { roundedPath, type Vertex } from '../lib/rounded-path';

/** A long brick seen from the side: four studs on top, one step down on the right. */
const studsAt = (positions: [number, number][], base: number, top: number): Vertex[] =>
  positions.flatMap(([from, to]): Vertex[] => [[from, base, 2], [from, top, 9], [to, top, 9], [to, base, 2]]);

const wide = roundedPath(
  [
    [0, 30, 18],
    ...studsAt([[67.5, 149], [214.5, 296.5], [363, 446.5]], 30, 0),
    [508.5, 30, 2], [508.5, 0, 9], [591.5, 0, 9], [591.5, 62.5, 2], [654, 62.5, 18], [654, 245, 18], [0, 245, 18],
  ],
  16,
);

const narrow = roundedPath(
  [
    [0, 26, 18],
    ...studsAt([[24, 84], [114, 174], [204, 264]], 26, 0),
    [294, 26, 2], [294, 0, 9], [354, 0, 9], [354, 26, 18], [380, 26, 18], [380, 480, 18], [0, 480, 18],
  ],
  16,
);
---

<section class="parties" id="fiestas" data-scroll-progress data-start="1" data-end="0.4">
  <!-- Everything but the loose corner brick moves as one: the section itself is what gets measured. -->
  <div class="block snap">
  <svg class="shape shape--wide" viewBox="0 0 654 245" aria-hidden="true">
    <path d={wide} fill="url(#paint-royal)" filter="url(#plastic)" />
  </svg>
  <svg class="shape shape--narrow" viewBox="0 0 380 480" aria-hidden="true">
    <path d={narrow} fill="url(#paint-royal)" filter="url(#plastic)" />
  </svg>

  <Picture
    class="room"
    src={photo}
    alt="Mesas naranjas con sillas negras entre columnas rayadas en rojo y blanco y luces de neón"
    formats={['avif', 'webp']}
    widths={[480, 792]}
    sizes="(max-width: 859px) 90vw, 500px"
  />

  <div class="copy">
    <h2><span class="burst">Fiestas en<br />Playzone</span></h2>
    <p>Área privada para fiestas</p>
    <a class="btn btn--yellow" href={LINKS.book}>Aparta tu fecha</a>
  </div>
  </div>

  <svg class="corner drop" data-drop viewBox="0 0 80 62" aria-hidden="true">
    <rect width="80" height="62" rx="9" fill="url(#paint-blue)" filter="url(#plastic)" />
    <circle cx="23.5" cy="32" r="12.5" fill="url(#stud-blue)" filter="url(#plastic-stud)" />
    <circle cx="55" cy="32" r="12.5" fill="url(#stud-blue)" filter="url(#plastic-stud)" />
  </svg>
</section>

<style>
  .parties {
    --p: 1;
    position: relative;
    width: 65.4rem;
    height: 24.5rem;
    margin: 5.5rem auto 0;
  }

  /* Drops onto the page from above and clicks down onto it. */
  .block {
    --q: clamp(0, var(--p) / 0.6, 1);
    position: absolute;
    inset: 0;
    opacity: clamp(0, var(--q) * 3, 1);
    transform: translateY(calc(var(--off) * -5rem)) rotate(calc(var(--off) * 2deg)) scale(calc(1 + var(--off) * 0.04));
  }

  .shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0.6rem 0.8rem rgb(10 50 130 / 0.16));
  }

  .shape--narrow { display: none; }

  :global(.room) {
    position: absolute;
    top: 5.55rem;
    left: 2.1rem;
    width: 30.5rem;
    height: 17rem;
    border-radius: 1.5rem;
    object-fit: cover;
    /* Portrait photo: the view pans down the room, over the tables, as the page scrolls. */
    object-position: 50% calc(40% + var(--p) * 30%);
  }

  .copy {
    position: absolute;
    top: 5.6rem;
    left: 35.9rem;
    color: #fff;
    opacity: clamp(0, (var(--q) - 0.45) * 3, 1);
    translate: calc((1 - clamp(0, (var(--q) - 0.45) * 2, 1)) * 3rem) 0;
  }

  .copy .burst::after { transform: scale(clamp(0, (var(--p) - 0.7) / 0.3, 1)); }

  h2 { font-size: 4.25rem; font-weight: 900; line-height: 0.94; }

  .copy p { margin: 0.8rem 0 1.4rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.015em; }


  /* The loose brick is dropped onto the corner of the big one after that has landed. */
  .corner {
    --tumble: 70deg;
    --drop-delay: 0.45s;
    position: absolute;
    right: -0.25rem;
    bottom: -0.25rem;
    width: 8rem;
    overflow: visible;
    filter: drop-shadow(0 0.3rem 0.5rem rgb(0 20 80 / 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .block, .copy .burst::after { transform: none; }
    .block, .copy { opacity: 1; translate: none; }
  }

  @media (width < 860px) {
    .parties { width: 38rem; height: 48rem; margin-top: 3.4rem; }
    .shape--wide { display: none; }
    .shape--narrow { display: block; }

    :global(.room) { top: 4.6rem; left: 2rem; width: 34rem; height: 22rem; }

    .copy { top: 28.4rem; left: 2.4rem; }
    h2 { font-size: 4.6rem; }
    .copy p { font-size: 1.9rem; }
  }
</style>
